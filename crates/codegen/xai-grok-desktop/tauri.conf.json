{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grok Desktop",
  "version": "0.1.220-alpha.4",
  "identifier": "ai.grok.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grok Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["bin/xai-grok-pager"]
  }
}
